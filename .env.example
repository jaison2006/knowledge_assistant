APP_ENV=development
DATA_DIR=./data
DATABASE_URL=sqlite:///data/knowledge.db

# Keep "none" for the offline lexical fallback.
EMBEDDING_PROVIDER=none
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Supported service wiring starts offline; add a provider implementation before enabling cloud generation.
LLM_PROVIDER=none
LLM_MODEL=
OPENAI_API_KEY=

CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=20
RERANK_TOP_K=8
SEMANTIC_WEIGHT=0.7
LEXICAL_WEIGHT=0.3
MAX_UPLOAD_MB=50OPENAI_API_KEY=your_key_here
